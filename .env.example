# Copy to .env and fill in. .env is gitignored -- never commit real values.
# WooCommerce connection details are NOT configured here: each merchant's WordPress plugin registers its own installation
# (site URL + REST consumer key/secret) with this service.

# --- Service ---
PORT=4300
# Public address of this service (payment return URLs, invoice links). Must be https:// when deployed.
PUBLIC_BASE_URL=http://localhost:4300
NODE_ENV=development
# Logging: LOG_LEVEL debug|info|warn|error (default debug in development, info in production);
# LOG_FORMAT text|json (use json in production so a log shipper can parse it). Secrets are redacted either way.
LOG_LEVEL=info
LOG_FORMAT=text
# Log files: logs/app.log (everything) and logs/error.log (warnings and errors). Every day at LOG_ROTATE_AT (server local time) and whenever
# a file passes LOG_MAX_BYTES (10 MB) it is zipped (app-2026-10-08.zip, app-2026-10-08-153012.zip) and a new file is started.
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_ROTATE_AT=00:05
# Delete archives older than this many days (0 = keep everything).
LOG_RETENTION_DAYS=0

# --- WooCommerce REST client ---
# auto = HTTP Basic over https, OAuth 1.0a (signed, secret never sent) over plain http (development stores).
# basic = always HTTP Basic (https only); oauth = always OAuth 1.0a; query = key/secret as query parameters (https only; the
# secret reaches access logs, so only for hosts that strip the Authorization header).
WOO_AUTH_MODE=auto
# In production every WooCommerce store must be an https:// address on a public host (plain http and private networks are refused).
WOO_TIMEOUT_MS=20000
WOO_MAX_RETRIES=4

# --- Database (PostgreSQL) ---
# The running service connects as a role WITHOUT BYPASSRLS so row-level security applies; migrations use the owner role.
# The adapter's data is its OWN SCHEMA (DB_SCHEMA, default woocommerce_adapter) inside the shared PostgreSQL database ltx_1jnl (the
# same server and database the Shopify adapter uses, in its own schema). Both roles below are dedicated to this adapter and are created
# once by a database administrator:  DATABASE_SUPERUSER_URL=postgresql://<admin>@127.0.0.1:5432/ltx_1jnl node scripts/db/provision.js
# (that administrator URL is used only by that script and by the tests, never by the running service; keep it out of this file).
DATABASE_URL=postgresql://woocommerce_adapter_app:CHANGE-ME@127.0.0.1:5432/ltx_1jnl
DATABASE_ADMIN_URL=postgresql://woocommerce_adapter_owner:CHANGE-ME@127.0.0.1:5432/ltx_1jnl
DB_SCHEMA=woocommerce_adapter
# The service's share of the shared server's connections (the owner role used for migrations adds at most 2 for a moment).
DB_POOL_MAX=8
DB_IDLE_TIMEOUT_MS=30000
# ROLLBACK to the old single-purpose database (docker compose up -d db, port 5435): DATABASE_URL=postgresql://adapter_app:adapter_app_local@127.0.0.1:5435/woocommerce_adapter,
# DATABASE_ADMIN_URL=postgresql://adapter_owner:adapter_owner_local@127.0.0.1:5435/woocommerce_adapter and DB_SCHEMA=public.
# disable | require (TLS + the server certificate is verified; use this for any remote database) | no-verify (never in production)
DB_SSL=disable
# Path to the CA certificate that signed the database server, when it is not a public CA (managed databases publish theirs).
DB_SSL_CA=

# --- Secrets ---
# 32 random bytes as 64 hex characters. Encrypts installation secrets and WooCommerce keys, signs browser sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   Losing it invalidates stored secrets.
ADAPTER_SECRET_KEY=

# First staff account for /admin, created only when there are no staff accounts yet.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Staff console sign-in protection. Two-factor (TOTP) is required in production by default.
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCK_MINUTES=15
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_HOURS=8
# ADMIN_REQUIRE_2FA=true

# --- Payments ---
# ICICI Bank payment gateway (the only one). Sandbox (UAT) address below; production uses https://pgpay.icicibank.com
ICICI_PG_BASE_URL=https://pgpayuat.icicibank.com
ICICI_PG_MERCHANT_ID=
ICICI_PG_AGGREGATOR_ID=
ICICI_PG_SECRET_KEY=
# Source addresses of ICICI's Payment Advice webhook (comma separated, CIDR allowed). Empty = not restricted (signature still checked).
ICICI_CALLBACK_ALLOWED_IPS=

# --- Hardening ---
# Shared secret the video engine sends in the X-Webhook-Secret header of its callback. Empty = callback accepted unsigned.
VIDEO_ENGINE_WEBHOOK_SECRET=
# Extra host names this server may call besides the configured video engine hosts (comma separated).
OUTBOUND_ALLOWED_HOSTS=
# Where vulnerability reports go (served at /.well-known/security.txt).
SECURITY_CONTACT=mailto:security@flipick.com
# Monitoring script limits (scripts/check-health.js)
HEALTH_PENDING_MINUTES=30
HEALTH_REFUND_DAYS=3

# --- Billing ---
BILLING_GRACE_DAYS=3
BILLING_REMINDER_DAYS=5
# PLACEHOLDERS: confirm with your accountant / set the real rate before launch.
GST_RATE_BP=1800
INR_PER_USD=83
SELLER_NAME=Flipick
SELLER_ADDRESS=
SELLER_GST_NUMBER=

# --- Flipick video engine (shared by all merchants) ---
FLIPICK_SPONSORED_ADS_BASE_URL=
FLIPICK_VVP_API_KEY=
FLIPICK_TENANT_ID=
RETAILER_NAME=
# Optional: product attribute whose option labels name a product's category (default product_type; a store can override it).
# MAGENTO_CATEGORY_ATTRIBUTE_CODE=product_type
FLIPICK_VIDEO_ENGINE_BASE_URL=
FLIPICK_VIDEO_ENGINE_API_KEY=
