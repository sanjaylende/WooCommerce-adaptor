# Copy to .env (git-ignored) and adjust. Development values only -- never reuse them anywhere real.

# --- Ports (the Magento test stores use 8080/8081, the adapters 4100/4200/4300) ---
WP_PORT=8085
PMA_PORT=8086

# Public address of the store as the browser AND the adapter will use it. Plain http is fine locally;
# the adapter then authenticates with consumer_key / consumer_secret query parameters (WOO_AUTH_MODE=auto).
WP_SITE_URL=http://localhost:8085

# --- Database ---
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=change-me-wp
WP_DB_ROOT_PASSWORD=change-me-root

# --- WordPress admin (created by setup.sh) ---
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=admin@example.test
WP_SITE_TITLE="Flipick Woo Test Store"

# --- Store basics ---
# Pinned: newer WooCommerce releases require a newer WordPress than the pinned wordpress image.
WC_VERSION=9.9.5
WC_CURRENCY=USD
WC_COUNTRY=US:CA
WC_PRICES_INCLUDE_TAX=no

# --- Flipick adapter this store talks to (the plugin's default; editable in wp-admin) ---
# Reachable FROM THE CONTAINER: host.docker.internal is this machine from inside Docker Desktop.
FLIPICK_ADAPTER_URL=http://host.docker.internal:4300

# WooCommerce REST keys are generated by setup.sh and written to .env.local (git-ignored), not here.
